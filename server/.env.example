# Copy to server/.env. These are server-only settings.
FIREBASE_PROJECT_ID=venturepilot-cf134
AGENT_PORT=8787
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
MODEL_DEFAULT=qwen2.5:3b
# Each agent has a separate inference context. Set a different installed model here
# to use different weights. Reusing one small model saves RAM.
MODEL_PLANNER=qwen2.5:3b
MODEL_PRODUCT=qwen2.5:3b
MODEL_FINANCE=qwen2.5:3b
MODEL_COMPLIANCE=qwen2.5:3b
MODEL_TEAM=qwen2.5:3b
MODEL_SCALING=qwen2.5:3b
MODEL_REVIEWER=llama3.2:3b
VECTOR_DATA_DIR=server/data
