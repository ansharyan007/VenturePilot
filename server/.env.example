# Copy to server/.env. These are server-only settings.
FIREBASE_PROJECT_ID=venturepilot-cf134
AGENT_PORT=8787
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
MODEL_DEFAULT=qwen3:8b
# Each agent has a separate inference context. Set a different installed model here
# to use different weights. Reusing one model avoids loading multiple weights.
MODEL_PLANNER=qwen3:8b
MODEL_PRODUCT=qwen3:8b
MODEL_FINANCE=qwen3:8b
MODEL_COMPLIANCE=qwen3:8b
MODEL_TEAM=qwen3:8b
MODEL_SCALING=qwen3:8b
MODEL_REVIEWER=qwen3:8b
VECTOR_DATA_DIR=server/data
